{
  "id": "superlocalmemory",
  "kind": "extension",
  "name": "Superlocalmemory",
  "description": "Local-first long-term memory using SQLite with vector search, graph edges, and coding intelligence",
  "version": "0.3.1",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "dbPath": { "type": "string" },
      "embeddingProvider": { "type": "string", "enum": ["openai", "ollama"] },
      "embeddingModel": { "type": "string" },
      "openaiApiKey": { "type": "string", "secret": true },
      "embeddingDimension": { "type": "number" },
      "ollamaModel": { "type": "string" },
      "ollamaEndpoint": { "type": "string" },
      "autoRecall": { "type": "boolean" },
      "autoCapture": { "type": "boolean" },
      "maxRecallResults": { "type": "number" },
      "profileFrequency": { "type": "number" },
      "dedupeThreshold": { "type": "number" },
      "debug": { "type": "boolean" },
      "projectContextPaths": {
        "type": "array",
        "items": { "type": "string" },
        "default": []
      },
      "projectIndexOnStart": { "type": "boolean", "default": true },
      "projectIndexGlobs": {
        "type": "array",
        "items": { "type": "string" },
        "default": ["**/README.md", "**/src/types/**/*.ts", "**/docs/architecture.md"]
      },
      "syncEnabled": { "type": "boolean", "default": false },
      "syncKey": { "type": "string", "default": "", "secret": true }
    }
  },
  "uiHints": {
    "dbPath": { "label": "Database Path", "placeholder": "~/.openclaw/superlocalmemory.db" },
    "embeddingProvider": { "label": "Embedding Provider" },
    "embeddingModel": { "label": "OpenAI Embedding Model", "placeholder": "text-embedding-3-small" },
    "openaiApiKey": { "label": "OpenAI API Key", "help": "Optional. If unset, plugin falls back to OPENAI_API_KEY env var.", "secret": true },
    "ollamaModel": { "label": "Ollama Model", "placeholder": "nomic-embed-text" },
    "ollamaEndpoint": { "label": "Ollama Endpoint", "placeholder": "http://localhost:11434" },
    "autoRecall": { "label": "Auto-Recall", "help": "Inject relevant memories before each turn" },
    "autoCapture": { "label": "Auto-Capture", "help": "Capture memories after each turn (includes code patterns, error-fix pairs, WIP)" },
    "maxRecallResults": { "label": "Max Recall Results" },
    "profileFrequency": { "label": "Profile Build Frequency", "help": "Rebuild profile every N captures" },
    "dedupeThreshold": { "label": "Dedup Threshold", "help": "Cosine similarity threshold for dedup (0-1)" },
    "debug": { "label": "Debug Mode" },
    "projectContextPaths": { "label": "Project Context Paths", "help": "Paths to index on startup (files or directories)" },
    "projectIndexOnStart": { "label": "Index on Start", "help": "Auto-index project context paths when plugin starts" },
    "projectIndexGlobs": { "label": "Project Index Globs", "help": "Glob patterns for project file discovery" },
    "syncEnabled": { "label": "Enable Sync", "help": "Enable Hyperswarm-based P2P memory sync" },
    "syncKey": { "label": "Sync Key", "help": "Shared 32-byte hex key (generate via superlocalmemory_sync_keygen)", "secret": true }
  }
}
