{
  "id": "plureslm",
  "kind": "extension",
  "name": "Plures LM",
  "description": "Plures LM — local-first long-term memory with vector search, code intelligence, and Hyperswarm P2P sync",
  "version": "2.0.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "dbPath": {
        "type": "string"
      },
      "embeddingProvider": {
        "type": "string",
        "enum": [
          "transformers",
          "ollama"
        ]
      },
      "embeddingModel": {
        "type": "string"
      },
      "transformersModel": {
        "type": "string"
      },
      "openaiApiKey": {
        "type": "string",
        "secret": true
      },
      "embeddingDimension": {
        "type": "number"
      },
      "ollamaModel": {
        "type": "string"
      },
      "ollamaEndpoint": {
        "type": "string"
      },
      "ollamaFallbackEndpoint": {
        "type": "string"
      },
      "autoRecall": {
        "type": "boolean"
      },
      "autoCapture": {
        "type": "boolean"
      },
      "maxRecallResults": {
        "type": "number"
      },
      "profileFrequency": {
        "type": "number"
      },
      "dedupeThreshold": {
        "type": "number"
      },
      "debug": {
        "type": "boolean"
      },
      "projectContextPaths": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "projectIndexOnStart": {
        "type": "boolean",
        "default": false
      },
      "projectIndexGlobs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "**/README.md",
          "**/src/types/**/*.ts",
          "**/docs/architecture.md"
        ]
      },
      "syncEnabled": {
        "type": "boolean",
        "default": false
      },
      "syncKey": {
        "type": "string",
        "default": "",
        "secret": true
      },
      "agentId": {
        "type": "string",
        "default": ""
      },
      "agentName": {
        "type": "string",
        "default": ""
      },
      "sessionStartRecall": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "maxMemories": {
            "type": "number",
            "default": 15
          },
          "priorityCategories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "decision",
              "preference",
              "explicit",
              "work-in-progress"
            ]
          },
          "recencyBias": {
            "type": "number",
            "default": 0.7
          }
        },
        "default": {
          "enabled": true,
          "maxMemories": 15,
          "priorityCategories": [
            "decision",
            "preference",
            "explicit",
            "work-in-progress"
          ],
          "recencyBias": 0.7
        }
      },
      "patternsDirs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "description": "Additional directories to scan for user YAML pattern files"
      },
      "patternsWatch": {
        "type": "boolean",
        "default": true,
        "description": "Hot-reload YAML pattern files when they change (no restart required)"
      },
      "autoLinkOnStore": {
        "type": "boolean",
        "default": false,
        "description": "Automatically trigger relationship discovery when a memory is stored"
      },
      "autoLinkAlgorithms": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "semantic",
            "category",
            "temporal"
          ]
        },
        "default": [
          "semantic",
          "category"
        ],
        "description": "Algorithms to use for auto-linking. Valid values: \"semantic\", \"category\", and \"temporal\". Currently, algorithm selection is automatic and this list is reserved for future configuration."
      },
      "autoLinkThresholds": {
        "type": "object",
        "default": {
          "semantic": 0.7,
          "category": 0.6,
          "temporal": 0.5
        },
        "description": "Per-algorithm strength thresholds for auto-linking (0.0–1.0)"
      },
      "maxAutoLinkDepth": {
        "type": "number",
        "default": 2,
        "description": "Maximum traversal depth for graph_neighbors queries"
      },
      "captureQuality": {
        "type": "object",
        "description": "Quality gate configuration for auto-capture",
        "properties": {
          "minContentLength": {
            "type": "number",
            "default": 50,
            "description": "Minimum content length to store (characters)"
          },
          "maxCapturesPerTurn": {
            "type": "number",
            "default": 5,
            "description": "Maximum new captures per agent_end turn"
          },
          "dedupeThreshold": {
            "type": "number",
            "default": 0.85,
            "description": "Cosine-similarity threshold for semantic dedup (0–1)"
          }
        },
        "default": {
          "minContentLength": 50,
          "maxCapturesPerTurn": 5,
          "dedupeThreshold": 0.85
        }
      }
    }
  },
  "uiHints": {
    "dbPath": {
      "label": "Database Path",
      "placeholder": "~/.openclaw/pluresLM-store"
    },
    "embeddingProvider": {
      "label": "Embedding Provider"
    },
    "embeddingModel": {
      "label": "OpenAI Embedding Model",
      "placeholder": "text-embedding-3-small"
    },
    "openaiApiKey": {
      "label": "OpenAI API Key",
      "help": "Optional. If unset, plugin falls back to OPENAI_API_KEY env var.",
      "secret": true
    },
    "ollamaModel": {
      "label": "Ollama Model",
      "placeholder": "nomic-embed-text"
    },
    "ollamaEndpoint": {
      "label": "Ollama Endpoint (GPU primary)",
      "placeholder": "http://172.21.176.1:11434"
    },
    "ollamaFallbackEndpoint": {
      "label": "Ollama Fallback Endpoint (CPU)",
      "placeholder": "http://127.0.0.1:11435"
    },
    "autoRecall": {
      "label": "Auto-Recall",
      "help": "Inject relevant memories before each turn"
    },
    "autoCapture": {
      "label": "Auto-Capture",
      "help": "Capture memories after each turn (includes code patterns, error-fix pairs, WIP)"
    },
    "maxRecallResults": {
      "label": "Max Recall Results"
    },
    "profileFrequency": {
      "label": "Profile Build Frequency",
      "help": "Rebuild profile every N captures"
    },
    "dedupeThreshold": {
      "label": "Dedup Threshold",
      "help": "Cosine similarity threshold for dedup (0-1)"
    },
    "debug": {
      "label": "Debug Mode"
    },
    "projectContextPaths": {
      "label": "Project Context Paths",
      "help": "Paths to index on startup (files or directories)"
    },
    "projectIndexOnStart": {
      "label": "Index on Start",
      "help": "Auto-index project context paths when plugin starts"
    },
    "projectIndexGlobs": {
      "label": "Project Index Globs",
      "help": "Glob patterns for project file discovery"
    },
    "syncEnabled": {
      "label": "Enable Sync",
      "help": "Enable Hyperswarm-based P2P memory sync"
    },
    "syncKey": {
      "label": "Sync Key",
      "help": "Shared 32-byte hex key (generate via pluresLM_sync_keygen)",
      "secret": true
    },
    "agentId": {
      "label": "Agent ID",
      "help": "Unique identifier for this agent instance (e.g. 'desktop', 'surface'). Used for multi-agent memory attribution.",
      "placeholder": "desktop"
    },
    "agentName": {
      "label": "Agent Name",
      "help": "Human-readable name for this agent (e.g. 'Desktop', 'Surface Laptop'). Shown in attributed memories.",
      "placeholder": "Desktop"
    },
    "sessionStartRecall": {
      "label": "Session Start Recall",
      "help": "Inject important memories at session start without user message"
    },
    "patternsDirs": {
      "label": "Pattern Directories",
      "help": "Additional directories to scan for user YAML pattern files"
    },
    "patternsWatch": {
      "label": "Hot-reload Patterns",
      "help": "Watch pattern directories for changes and reload without restart"
    },
    "autoLinkOnStore": {
      "label": "Auto-Link on Store",
      "help": "Automatically discover relationships when a new memory is stored (background task)"
    },
    "autoLinkAlgorithms": {
      "label": "Auto-Link Algorithms",
      "help": "Algorithms for auto-linking: semantic, category, temporal"
    },
    "autoLinkThresholds": {
      "label": "Auto-Link Thresholds",
      "help": "Per-algorithm strength thresholds (0.0–1.0) for auto-linking"
    },
    "maxAutoLinkDepth": {
      "label": "Max Auto-Link Depth",
      "help": "Maximum traversal depth for graph_neighbors queries (default: 2)"
    }
  }
}
