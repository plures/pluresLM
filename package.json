{
  "name": "@plures/plureslm",
  "version": "2.2.0",
  "description": "Plures LM — local-first long-term memory plugin for OpenClaw with native PluresDB CRDT storage, HNSW vector search, and Hyperswarm P2P sync.",
  "license": "BSL-1.1",
  "author": "Plures <hello@plures.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/plures/pluresLM.git"
  },
  "keywords": [
    "memory",
    "vector-search",
    "pluresdb",
    "crdt",
    "openclaw",
    "embeddings",
    "local-first",
    "ai",
    "hnsw"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./db": {
      "import": "./dist/memory-db.js",
      "types": "./dist/memory-db.d.ts"
    },
    "./embeddings": {
      "import": "./dist/embeddings.js",
      "types": "./dist/embeddings.d.ts"
    },
    "./lib": {
      "import": "./dist/lib.js",
      "types": "./dist/lib.d.ts"
    },
    "./patterns": {
      "import": "./dist/patterns.js",
      "types": "./dist/patterns.d.ts"
    }
  },
  "bin": {
    "pluresLM": "./scripts/setup-openclaw.cjs",
    "plureslm-service": "./dist/plureslm-service.js",
    "plureslm-mcp": "./dist/mcp-server.js"
  },
  "files": [
    "dist",
    "scripts/setup-openclaw.cjs",
    "scripts/verify-native.cjs",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-patterns.js",
    "service": "node dist/plureslm-service.js",
    "mcp": "node dist/mcp-server.js",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "mcp:smoke:ci": "node scripts/mcp-smoke.mjs --ci",
    "test": "vitest run",
    "test:load": "node --input-type=module -e \"await import('./dist/index.js'); console.log('plugin loads OK')\"",
    "test:watch": "vitest",
    "test:patterns": "tsx test-patterns.ts",
    "migrate": "tsx migrate.ts",
    "lint": "eslint .",
    "migrate:pluresdb": "tsx src/migrate-to-pluresdb.ts",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/verify-native.cjs || true",
    "version": "node scripts/sync-plugin-version.js && git add openclaw.plugin.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@plures/pluresdb": "^2.9.7",
    "@plures/praxis": "^2.4.39",
    "@sinclair/typebox": "^0.34.48",
    "better-sqlite3": "^12.6.2",
    "hyperswarm": "^4.17.0",
    "js-yaml": "^4.1.1",
    "mustache": "^4.2.0",
    "p-throttle": "^8.1.0",
    "zod": "^4.3.6",
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/mustache": "^4.2.6",
    "@types/node": "^25.3.5",
    "eslint": "^10.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.0.18"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
