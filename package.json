{
  "name": "@plures/pluresLM",
  "version": "0.20.0",
  "description": "Plures LM — local-first long-term memory plugin for OpenClaw with native PluresDB CRDT storage, HNSW vector search, and Hyperswarm P2P sync.",
  "license": "AGPL-3.0",
  "author": "Plures <hello@plures.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/plures/pluresLM.git"
  },
  "keywords": [
    "memory",
    "vector-search",
    "pluresdb",
    "crdt",
    "openclaw",
    "embeddings",
    "local-first",
    "ai",
    "hnsw"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./db": {
      "import": "./dist/memory-db.js",
      "types": "./dist/memory-db.d.ts"
    },
    "./embeddings": {
      "import": "./dist/embeddings.js",
      "types": "./dist/embeddings.d.ts"
    },
    "./lib": {
      "import": "./dist/lib.js",
      "types": "./dist/lib.d.ts"
    },
    "./patterns": {
      "import": "./dist/patterns.js",
      "types": "./dist/patterns.d.ts"
    }
  },
  "bin": {
    "pluresLM": "./dist/migrate-to-pluresdb.js"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-patterns.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:patterns": "tsx test-patterns.ts",
    "migrate": "tsx migrate.ts",
    "migrate:pluresdb": "tsx src/migrate-to-pluresdb.ts",
    "prepublishOnly": "npm run build",
    "version": "node scripts/sync-plugin-version.js && git add openclaw.plugin.json"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.48",
    "hyperswarm": "^4.16.0",
    "js-yaml": "^4.1.1",
    "mustache": "^4.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
